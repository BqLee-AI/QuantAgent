# apps/api 本地环境变量示例。
# 这里只放 API 传输层和本地单用户鉴权专属变量。
# DATABASE_URL、RUNTIME_DIR、LOG_LEVEL 等共享变量继续从仓库根目录 .env 或外部环境提供。
# 复制为 apps/api/.env 后按需修改，不要提交真实 secret。

# API 本地开发监听地址。
API_HOST=127.0.0.1
API_PORT=8000
API_V1_PREFIX=/api/v1

# API 本地单用户鉴权配置。
AUTH_ENABLED=true
AUTH_ADMIN_PASSWORD=12345678
AUTH_SESSION_SECRET=dev-session-secret-change-me
AUTH_COOKIE_NAME=quantagent_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_SESSION_LIFETIME_SECONDS=43200
AUTH_SESSION_ABSOLUTE_LIFETIME_SECONDS=86400
AUTH_SESSION_REFRESH_THRESHOLD_SECONDS=1800
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
