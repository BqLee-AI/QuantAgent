# Shared application environment, for example local/staging/production.
APP_ENV=local

# Host-side database URL for local tools. The sample port avoids local 5432 conflicts.
DATABASE_URL=postgresql+psycopg://quantagent:quantagent@localhost:15432/quantagent

# Container-side database URL used by the API service in docker-compose.yml.
API_DATABASE_URL=postgresql+psycopg://quantagent:quantagent@db:5432/quantagent

# Host-side runtime directory used outside containers.
RUNTIME_DIR=./runtime

# Application log level, for example DEBUG/INFO/WARNING/ERROR.
LOG_LEVEL=INFO

# API bind host and published host port for docker-compose.yml.
API_HOST=0.0.0.0
API_PORT=8000

# Runtime directory inside the API container.
API_RUNTIME_DIR=/app/runtime

# Published host port for the Compose db service.
DB_PORT=15432

# Local PostgreSQL database settings for the Compose db service.
POSTGRES_DB=quantagent
POSTGRES_USER=quantagent
POSTGRES_PASSWORD=quantagent
