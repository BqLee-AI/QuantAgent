{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discord Interaction Webhook Source Plugin Config",
  "type": "object",
  "properties": {
    "public_key_ref": {
      "type": "string",
      "title": "Discord Public Key Reference",
      "description": "Reference to the Discord application public key used for official Ed25519 verification.",
      "minLength": 1,
      "x-quantagent-secret-ref": true
    },
    "response_text": {
      "type": "string",
      "title": "Response Text",
      "description": "Ephemeral response text returned to supported application commands.",
      "minLength": 1,
      "default": "QuantAgent received your Discord interaction."
    },
    "guild_allowlist": {
      "type": "array",
      "title": "Guild Allowlist",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "channel_allowlist": {
      "type": "array",
      "title": "Channel Allowlist",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    }
  },
  "required": [
    "public_key_ref"
  ],
  "additionalProperties": false
}
