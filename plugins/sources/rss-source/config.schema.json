{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RSS Source Plugin Config",
  "type": "object",
  "properties": {
    "feeds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60,
      "default": 10
    },
    "user_agent": {
      "type": "string",
      "default": "QuantAgent RSS Source/0.1"
    },
    "max_items": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "default": 50
    }
  },
  "required": ["feeds"],
  "additionalProperties": false
}

